# ── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Steam OpenID ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
STEAM_API_KEY=your-steam-api-key

# ── PricEmpire API (20+ markets in one call — highly recommended) ──
PRICEMPIRE_API_KEY=your-pricempire-api-key

# ── Skinstrack API (PRIMARY price source) ───────────────────────────
SKINSTRACK_API_KEY=your-skinstrack-api-key
SKINSTRACK_TIER=Free

# ── CSFloat API (float/pattern listings only) ─────────────────────────
CSFLOAT_API_KEY=your-csfloat-api-key

# ── Skinport (fallback pricing, no key needed) ────────────────────────
SKINPORT_CLIENT_ID=
SKINPORT_CLIENT_SECRET=

# ── Cron auth ─────────────────────────────────────────────────────────
CRON_SECRET=your-random-cron-secret

# ── Rate limiting ────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
